+def _make_tty_listener_for_key_test(*, failure_enters_intervention: bool):
+    events = {
+        "exit_early": False,
+        "rerecord_episode": False,
+        "episode_outcome": None,
+        "policy_failure_detected": False,
+        "preventive_intervention_detected": False,
+        "intervention_kind": None,
+        "failure_recovery_active": False,
+        "enter_intervention": False,
+        "confirm_intervention": False,
+        "intervention_handover_pending": False,
+        "confirm_reset": False,
+        "phase": "recording",
+    }
+    listener = object.__new__(TTYKeyboardListener)
+    listener.events = events
+    listener.intervention_toggle_key = "space"
+    listener.intervention_toggle_enabled = True
+    listener.pause_toggle_key = None
+    listener.episode_success_key = "s"
+    listener.episode_failure_key = "f"
+    listener.episode_preventive_key = None
+    listener.episode_terminal_failure_key = None
+    listener.failure_enters_intervention = failure_enters_intervention
+    listener._last_intervention_time = 0.0
+    listener._last_pause_time = 0.0
+    return listener, events
+
+
+def test_failure_key_enters_intervention_without_ending_episode():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+
+    listener._handle_key("f")
+
+    assert events["policy_failure_detected"] is True
+    assert events["failure_recovery_active"] is True
+    assert events["enter_intervention"] is True
+    assert events["episode_outcome"] is None
+    assert events["exit_early"] is False
+
+
+def test_success_after_failure_recovery_ends_episode_as_success():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener._handle_key("f")
+
+    listener._handle_key("s")
+
+    assert events["episode_outcome"] == "success"
+    assert events["exit_early"] is True
+
+
+def test_enter_sets_independent_reset_confirmation_event():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    events["phase"] = "reset"
+
+    listener._handle_key("\r")
+
+    assert events["confirm_reset"] is True
+    assert events["exit_early"] is False
+
+
+def test_enter_confirms_intervention_handover_without_confirming_reset():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    events["phase"] = "intervention_handover"
+
+    listener._handle_key("\r")
+
+    assert events["confirm_intervention"] is True
+    assert events["confirm_reset"] is False
+    assert events["exit_early"] is False
+
+
+def test_outcome_keys_are_ignored_during_intervention_handover():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    events["phase"] = "intervention_handover"
+
+    listener._handle_key("s")
+    listener._handle_key("f")
+
+    assert events["episode_outcome"] is None
+    assert events["policy_failure_detected"] is False
+    assert events["exit_early"] is False
+
+
+def test_space_pauses_and_resumes_execution():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.pause_toggle_key = "space"
+
+    listener._handle_key(" ")
+    assert events["paused"] is True
+
+    listener._last_pause_time = 0.0
+    listener._handle_key(" ")
+    assert events["paused"] is False
+
+
+def test_outcome_keys_are_ignored_while_paused():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.pause_toggle_key = "space"
+    events["paused"] = True
+
+    listener._handle_key("s")
+    listener._handle_key("f")
+
+    assert events["episode_outcome"] is None
+    assert events["policy_failure_detected"] is False
+    assert events["exit_early"] is False
+
+
+def test_outcome_keys_are_ignored_during_reset():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    events["phase"] = "reset"
+
+    listener._handle_key("s")
+    listener._handle_key("f")
+
+    assert events["episode_outcome"] is None
+    assert events["policy_failure_detected"] is False
+    assert events["exit_early"] is False
+
+
+def test_arrow_keys_can_replace_failure_and_success_keys():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.episode_failure_key = "left"
+    listener.episode_success_key = "right"
+
+    listener._handle_key("LEFT")
+
+    assert events["policy_failure_detected"] is True
+    assert events["failure_recovery_active"] is True
+    assert events["enter_intervention"] is True
+    assert events["exit_early"] is False
+
+    listener._handle_key("RIGHT")
+
+    assert events["episode_outcome"] == "success"
+    assert events["exit_early"] is True
+
+
+def test_up_arrow_records_preventive_intervention_separately_from_failure():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.episode_preventive_key = "up"
+    listener.episode_failure_key = "left"
+    listener.episode_success_key = "right"
+
+    listener._handle_key("UP")
+
+    assert events["preventive_intervention_detected"] is True
+    assert events["policy_failure_detected"] is False
+    assert events["intervention_kind"] == "preventive"
+    assert events["failure_recovery_active"] is True
+    assert events["enter_intervention"] is True
+    assert [item["event_type"] for item in events["hil_pending_events"]] == [
+        "preventive_notice"
+    ]
+
+    listener._handle_key("RIGHT")
+
+    assert events["episode_outcome"] == "success"
+    assert [item["event_type"] for item in events["hil_pending_events"]][-3:] == [
+        "human_takeover_end",
+        "preventive_complete",
+        "task_success",
+    ]
+
+
+def test_down_arrow_ends_failed_recovery_without_stopping_session():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.episode_failure_key = "left"
+    listener.episode_success_key = "right"
+    listener.episode_terminal_failure_key = "down"
+
+    listener._handle_key("LEFT")
+    listener._handle_key("DOWN")
+
+    assert events["episode_outcome"] == "failure"
+    assert events["exit_early"] is True
+    assert events.get("stop_recording", False) is False
+    assert [item["event_type"] for item in events["hil_pending_events"]] == [
+        "failure_notice",
+        "human_takeover_end",
+        "terminal_failure",
+    ]
+
+
+def test_down_arrow_is_ignored_before_recovery():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.episode_terminal_failure_key = "down"
+
+    listener._handle_key("DOWN")
+
+    assert events["episode_outcome"] is None
+    assert events["exit_early"] is False
+
+
+def test_arrow_outcome_keys_are_ignored_outside_recording_instead_of_using_legacy_actions():
+    listener, events = _make_tty_listener_for_key_test(failure_enters_intervention=True)
+    listener.episode_failure_key = "left"
+    listener.episode_success_key = "right"
+    events["phase"] = "reset"
+
+    listener._handle_key("LEFT")
+    listener._handle_key("RIGHT")
+
+    assert events["episode_outcome"] is None
+    assert events["policy_failure_detected"] is False
+    assert events["rerecord_episode"] is False
+    assert events["exit_early"] is False
